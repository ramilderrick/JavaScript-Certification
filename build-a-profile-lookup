//implementing a function that looks up a profile if theres a name match with its desired property
function lookUpProfile(name, property){
  const conArr = [...contacts];
  
  for (let i = 0; i < conArr.length; i++){
    if (conArr[i].firstName == name){
      if (conArr[i].hasOwnProperty(property)){
        return conArr[i][property]
      }

      return "No such property"
    } 
  }
  
  return "No such contact"
}

