//a function that takes a sentence and returns the longest string's length.
const findLongestWordLength = (stringArg) => {
  const words = stringArg.split(" ");
  let count = 0;
  let longest = words[0];
  for (count; count < words.length; count++){
    if (words[count].length > longest.length){
      longest = words[count];
    }
  }

  return longest.length;
}

//test cases
console.log(findLongestWordLength("The quick brown fox jumped over the lazy dog"));

console.log(findLongestWordLength("I ran three and a half miles the other day, but nearing the end of my run. My right leg went completely numb, I think I need to check with a doctor."));
