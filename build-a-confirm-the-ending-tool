//this function splits the string into a substring and checks if the later half includes the check input case.
const confirmEnding = (strInput, strCheck) => {
  console.log(strInput.length)
  let subString;

  //made it so that strings with smaller/longer length characters are divided by lower numbers. While strings with medium length are divided by a larger number.
  if (strInput.length < 7) {
    const threeFourth = Math.round(strInput.length/1.5);
    subString = strInput.substring(threeFourth)
    console.log(subString)
    subString = subString.includes(strCheck);
  } else if ((strInput.length >= 7) && (strInput.length <= 50)) {
    const oneThird = Math.round(strInput.length/3);
    subString = strInput.substring(oneThird)
    console.log(subString)
    subString = subString.includes(strCheck);
  } else {
    const divisable = Math.round(strInput.length/1.2);
    subString = strInput.substring(divisable)
    console.log(subString)
    subString = subString.includes(strCheck);
  }

  if(subString === true){
    return true;
  } else {
    return false;
  }
  
  
}

