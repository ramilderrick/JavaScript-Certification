//a function that takes an array of available choices and uses random to make the computer's choice out of the selection.
const getRandomComputerChoice = (choicesArray) => {
  const randomChoice = Math.floor(Math.random() * choicesArray.length);
  const choice = choicesArray[randomChoice];
  return choice;
}

